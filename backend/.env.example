# Copy to backend/.env (never commit .env). Everything runs locally and for free.

# --- LLM ---
# none   = extractive mode: no LLM, answers are the most relevant sentences (default)
# ollama = local open-source model served by Ollama (https://ollama.com), e.g. qwen2.5:3b
LLM_PROVIDER=none
# LLM_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=700

# --- Retrieval ---
VECTOR_STORE=chroma            # chroma | faiss
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_SIZE=300
CHUNK_OVERLAP=50
TOP_K=4
MIN_RELEVANCE=0.38             # below this cosine similarity -> "not in the documents"

# --- API / security ---
MAX_UPLOAD_MB=20
RATE_LIMIT_ASK_PER_MIN=20
RATE_LIMIT_INGEST_PER_MIN=5
CACHE_TTL_S=3600
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTO_INGEST_SAMPLE=false
# STATIC_DIR=../frontend/dist  # serve the built UI from the API on http://localhost:8000
